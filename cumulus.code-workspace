// =============================================================================
// Cumulus — multi-root workspace
//
// Five trees, one window:
//   cumulus-mcp-prototype   this repo (FastAPI + MCP + A2A server, Flutter admin)
//   cumulus-demo-ecosystem  the simulation engine we code against
//   cumulus-vision          Cumulus proper, rebuilt one step at a time with this repo as the guide
//   cumulus-plan-review-workbench  plan review workbench
//   customer-ai-projects    reference-only, mounted read-only
//
// The dev container opens this file (see `.devcontainer/devcontainer.json`'s
// `workspaceFolder`), and bind-mounts the other four directories from sibling
// paths on the host. Outside the container the same relative paths work
// whenever the five directories are cloned/created side by side.
//
// Folder-scoped settings use `${workspaceFolder:<name>}` — a bare
// `${workspaceFolder}` is ambiguous in a multi-root window.
// =============================================================================
{
    "folders": [
        {
            "name": "cumulus-mcp-prototype",
            "path": "."
        },
        {
            "name": "cumulus-demo-ecosystem",
            "path": "../cumulus-demo-ecosystem"
        },
        {
            "name": "cumulus-vision",
            "path": "../cumulus-vision"
        },
        {
            "name": "cumulus-plan-review-workbench",
            "path": "../cumulus-plan-review-workbench"
        },
        {
            "name": "customer-ai-projects",
            "path": "../customer-ai-projects"
        }
    ],
    "settings": {
        // The server's venv, not the base conda interpreter.
        "python.defaultInterpreterPath": "${workspaceFolder:cumulus-mcp-prototype}/server/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        // Tests must run with server/ as the working directory.
        "python.testing.pytestArgs": [
            "${workspaceFolder:cumulus-mcp-prototype}/server"
        ],
        // Both trees carry build output worth keeping out of search results.
        "search.exclude": {
            "**/.dart_tool": true,
            "**/.venv": true,
            "**/build": true,
            "**/node_modules": true,
            "**/__pycache__": true
        },
        "files.watcherExclude": {
            "**/.dart_tool/**": true,
            "**/.venv/**": true,
            "**/build/**": true,
            "**/node_modules/**": true
        }
    }
}