// =============================================================================
// Cumulus MCP Prototype — Dev Container
//
// One container for the whole prototype:
//   - Flutter *web* admin app in admin_app/ (pinned SDK, Chromium,
//     Firebase + FlutterFire CLIs), deployed to Firebase Hosting
//   - Python FastAPI server in server/ (venv at server/.venv) exposing REST,
//     MCP (Streamable HTTP), and A2A front doors; deployed to Cloud Run
//
// More directories ride along, bind-mounted from sibling paths on the host
// and opened as extra folders of a multi-root workspace, so all trees are
// searchable from one window. See `cumulus.code-workspace` and this folder's
// README.
//   - cumulus-demo-ecosystem/ — the simulation engine this prototype talks to
//   - cumulus-vision/         — Cumulus proper, rebuilt one step at a time with
//                               this repo as the guide; its API runs on :8081 locally
//   - cumulus-plan-review-workbench/ — the plan review workbench
//   - customer-ai-projects/   — reference-only, mounted read-only
//
// GCP project: cumulus-mcp-prototype (set below via CLOUDSDK_CORE_PROJECT —
// no `gcloud config set` needed, and the host's gcloud config is not mutated).
//
// Host prerequisites: Docker Desktop, the VS Code "Dev Containers" extension,
// the cumulus-demo-ecosystem, cumulus-vision, cumulus-plan-review-workbench,
// and customer-ai-projects
// directories cloned/created *beside* this one (the container will not start
// without them — Docker refuses a bind mount whose source is missing), and
// gcloud auth on the HOST (credentials are bind-mounted in):
//   gcloud auth login
//   gcloud auth application-default login
//
// Day-to-day commands inside the container:
//   cd admin_app && flutter run -d web-server --web-port 3000   # → localhost:3000
//   cd server && .venv/bin/uvicorn app.main:app --port 8080     # API on :8080
//   cd /workspaces/cumulus-vision/server && .venv/bin/uvicorn app.main:app --port 8081
//   ./deploy/deploy.sh cumulus-mcp-prototype                    # full deploy
// =============================================================================
{
    "name": "Cumulus MCP Prototype",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        // `gh` for pull requests and releases from inside the container.
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "mounts": [
        // The simulation engine we code against, cloned beside this repo on the
        // host. Bind-mounted (not copied) so edits and git history are shared
        // with the host checkout. If it lives elsewhere, change this source path.
        "source=${localWorkspaceFolder}/../cumulus-demo-ecosystem,target=/workspaces/cumulus-demo-ecosystem,type=bind,consistency=cached",
        // Cumulus proper, built one step at a time with this repo as the guide,
        // cloned beside it on the host. Same bind-mount treatment as above.
        "source=${localWorkspaceFolder}/../cumulus-vision,target=/workspaces/cumulus-vision,type=bind,consistency=cached",
        // The plan review workbench, cloned beside this repo on the host.
        "source=${localWorkspaceFolder}/../cumulus-plan-review-workbench,target=/workspaces/cumulus-plan-review-workbench,type=bind,consistency=cached",
        // Reference-only: another project directory, mounted read-only since
        // nothing in this workspace edits or runs it.
        "source=${localWorkspaceFolder}/../customer-ai-projects,target=/workspaces/customer-ai-projects,type=bind,consistency=cached,readonly",
        // Host gcloud config, so ADC and `gcloud` work without re-auth.
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/gcloud,target=/root/.config/gcloud,type=bind",
        // Persist Claude Code state (sessions, memory, login) across rebuilds.
        "source=cumulus-mcp-prototype-claude,target=/root/.claude,type=volume",
        // Keep `firebase login` credentials across rebuilds.
        "source=cumulus-mcp-prototype-configstore,target=/root/.config/configstore,type=volume",
        // Cache pub packages; seeded from the image so the FlutterFire CLI survives.
        "source=cumulus-mcp-prototype-pub-cache,target=/root/.pub-cache,type=volume"
    ],
    // Open the related repos at once. Pointing workspaceFolder at a .code-workspace
    // file makes VS Code open that multi-root workspace on attach; the default
    // workspaceMount (this repo -> /workspaces/cumulus-mcp-prototype) is unchanged.
    "workspaceFolder": "/workspaces/cumulus-mcp-prototype/cumulus.code-workspace",
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/root/.claude",
        "GOOGLE_CLOUD_PROJECT": "cumulus-mcp-prototype",
        "CLOUDSDK_CORE_PROJECT": "cumulus-mcp-prototype",
        // Firebase CLI authenticates off the bind-mounted ADC credential; the
        // firebase.googleapis.com API rejects user ADC without a quota project.
        "GOOGLE_CLOUD_QUOTA_PROJECT": "cumulus-mcp-prototype"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "Dart-Code.dart-code",
                "Dart-Code.flutter",
                "ms-python.python",
                "ms-python.debugpy",
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",
                "anthropic.claude-code",
                "GitHub.copilot",
                "redhat.vscode-yaml"
            ],
            "settings": {
                "dart.flutterSdkPath": "/usr/local/flutter",
                // `-d chrome` can't open a window from inside the container;
                // web-server + the host browser is the workflow.
                "dart.flutterRunAdditionalArgs": [
                    "-d",
                    "web-server",
                    "--web-port",
                    "3000",
                    "--web-hostname",
                    "0.0.0.0"
                ],
                "editor.formatOnSave": true,
                "[dart]": {
                    "editor.defaultFormatter": "Dart-Code.dart-code",
                    "editor.rulers": [
                        80
                    ],
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "explicit"
                    }
                },
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter"
                },
                "files.exclude": {
                    "**/.dart_tool": true,
                    "**/build": true,
                    "**/__pycache__": true
                },
                "terminal.integrated.defaultProfile.linux": "bash",
                "extensions.ignoreRecommendations": true
            }
        }
    },
    // Resolve dependencies for whichever halves of the repo exist yet:
    // admin_app/ (Flutter web admin) and server/ (FastAPI + MCP + A2A), plus
    // the venv in cumulus-vision/server once that tree has one to build.
    // Paths are absolute: with workspaceFolder pointing at a .code-workspace
    // file, the cwd lifecycle commands inherit is not worth relying on.
    // cumulus-demo-ecosystem/ bootstraps itself — see its own README.
    "postCreateCommand": "git config --global --add safe.directory /workspaces/cumulus-mcp-prototype && git config --global --add safe.directory /workspaces/cumulus-demo-ecosystem && git config --global --add safe.directory /workspaces/cumulus-vision && git config --global --add safe.directory /workspaces/cumulus-plan-review-workbench && git config --global --add safe.directory /workspaces/customer-ai-projects && { [ -f /workspaces/cumulus-mcp-prototype/admin_app/pubspec.yaml ] && (cd /workspaces/cumulus-mcp-prototype/admin_app && flutter pub get); [ -f /workspaces/cumulus-mcp-prototype/server/requirements.txt ] && (cd /workspaces/cumulus-mcp-prototype/server && python -m venv .venv && .venv/bin/pip install -r requirements.txt); [ -f /workspaces/cumulus-vision/server/requirements-dev.txt ] && (cd /workspaces/cumulus-vision/server && python -m venv .venv && .venv/bin/pip install -r requirements-dev.txt); [ -f /workspaces/cumulus-vision/console/pubspec.yaml ] && (cd /workspaces/cumulus-vision/console && flutter pub get); true; }",
    // Sign commits with the host's SSH key via the forwarded agent.
    "postStartCommand": "bash /workspaces/cumulus-mcp-prototype/.devcontainer/setup-git-signing.sh || true",
    "forwardPorts": [
        3000,
        8080,
        8081
    ],
    "portsAttributes": {
        "3000": {
            "label": "Flutter web dev server",
            "onAutoForward": "notify"
        },
        "8080": {
            "label": "Cumulus API / MCP (local)"
        },
        "8081": {
            "label": "cumulus-vision API (local)"
        }
    }
}